{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && npx --yes npm@11.6.2 ci",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "public",
  "regions": ["fra1"],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
