// Schéma de la base PostgreSQL (Neon en production).
// 14 tables du TRD + `lead` (demandes de devis, RF-18) + `refresh_token` (rotation des sessions).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum AdminRole {
  ADMIN
  EDITEUR
}

model Country {
  id           String   @id @default(cuid())
  isoCode      String   @unique @map("iso_code")
  name         String
  gridVoltageV Int      @map("grid_voltage_v")
  sortOrder    Int      @default(0) @map("sort_order")
  regions      Region[]

  @@map("country")
}

model Region {
  id                  String       @id @default(cuid())
  countryId           String       @map("country_id")
  country             Country      @relation(fields: [countryId], references: [id])
  name                String
  capital             String
  latitude            Float
  longitude           Float
  irradiationAvg      Float        @map("irradiation_avg")
  irradiationMinMonth Float        @map("irradiation_min_month")
  source              String
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at")
  simulations         Simulation[]

  @@unique([countryId, name])
  @@map("region")
}

model DeviceCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  iconUrl   String?  @map("icon_url")
  sortOrder Int      @default(0) @map("sort_order")
  devices   Device[]

  @@map("device_category")
}

model Device {
  id                 String         @id @default(cuid())
  categoryId         String         @map("category_id")
  category           DeviceCategory @relation(fields: [categoryId], references: [id])
  name               String
  iconUrl            String?        @map("icon_url")
  imageUrl           String?        @map("image_url")
  powerMinW          Float          @map("power_min_w")
  powerTypW          Float          @map("power_typ_w")
  powerMaxW          Float          @map("power_max_w")
  defaultHoursPerDay Float          @map("default_hours_per_day")
  dutyCycle          Float          @default(1) @map("duty_cycle")
  surgeFactor        Float          @default(1) @map("surge_factor")
  active             Boolean        @default(true)
  sortOrder          Int            @default(0) @map("sort_order")

  @@index([categoryId])
  @@map("device")
}

model PanelModel {
  id        String  @id @default(cuid())
  label     String
  powerWp   Float   @map("power_wp")
  vocV      Float   @map("voc_v")
  vmpV      Float   @map("vmp_v")
  iscA      Float   @map("isc_a")
  impA      Float   @map("imp_a")
  active    Boolean @default(true)
  isDefault Boolean @default(false) @map("is_default")

  @@map("panel_model")
}

model BatteryModel {
  id              String  @id @default(cuid())
  technology      String
  nominalVoltageV Float   @map("nominal_voltage_v")
  capacityAh      Float   @map("capacity_ah")
  dod             Float
  active          Boolean @default(true)

  @@map("battery_model")
}

model InverterModel {
  id                String  @id @default(cuid())
  type              String
  nominalPowerW     Float   @map("nominal_power_w")
  surgeFactor       Float   @map("surge_factor")
  dcVoltageV        Int     @map("dc_voltage_v")
  efficiency        Float
  mpptMaxCurrentA   Float?  @map("mppt_max_current_a")
  mpptMaxPvVoltageV Float?  @map("mppt_max_pv_voltage_v")
  active            Boolean @default(true)

  @@map("inverter_model")
}

model ControllerModel {
  id                String  @id @default(cuid())
  type              String
  maxCurrentA       Float   @map("max_current_a")
  maxPvVoltageV     Float   @map("max_pv_voltage_v")
  maxInputCurrentA  Float   @map("max_input_current_a")
  supportedVoltages Int[]   @map("supported_voltages")
  active            Boolean @default(true)

  @@map("controller_model")
}

model CableSection {
  id                String @id @default(cuid())
  sectionMm2        Float  @unique @map("section_mm2")
  allowableCurrentA Float  @map("allowable_current_a")

  @@map("cable_section")
}

model ProtectionRating {
  id      String @id @default(cuid())
  type    String
  ratingA Float  @map("rating_a")

  @@unique([type, ratingA])
  @@map("protection_rating")
}

/// Jamais modifié en place : chaque changement crée une nouvelle version.
/// La version active est celle dont `activeSince` est la plus récente.
model ParameterSet {
  id          String     @id @default(cuid())
  version     Int        @unique
  values      Json
  activeSince DateTime?  @map("active_since")
  createdById String?    @map("created_by")
  createdBy   AdminUser? @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now()) @map("created_at")

  @@map("parameter_set")
}

model Simulation {
  id            String   @id @default(uuid()) @db.Uuid
  mode          String
  regionId      String   @map("region_id")
  region        Region   @relation(fields: [regionId], references: [id])
  autonomyDays  Float    @map("autonomy_days")
  batteryTech   String   @map("battery_tech")
  inputs        Json
  overrides     Json?
  result        Json
  engineVersion String   @map("engine_version")
  paramsVersion Int      @map("params_version")
  shareToken    String   @unique @map("share_token")
  createdAt     DateTime @default(now()) @map("created_at")
  leads         Lead[]

  @@index([createdAt])
  @@map("simulation")
}

model AdminUser {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String         @map("password_hash")
  role           AdminRole      @default(EDITEUR)
  active         Boolean        @default(true)
  lastLoginAt    DateTime?      @map("last_login_at")
  failedLogins   Int            @default(0) @map("failed_logins")
  lockedUntil    DateTime?      @map("locked_until")
  createdAt      DateTime       @default(now()) @map("created_at")
  auditLogs      AuditLog[]
  refreshTokens  RefreshToken[]
  parameterSets  ParameterSet[]

  @@map("admin_user")
}

model AuditLog {
  id          String     @id @default(cuid())
  adminUserId String?    @map("admin_user_id")
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])
  entity      String
  entityId    String?    @map("entity_id")
  action      String
  before      Json?
  after       Json?
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

/// Hors TRD : jetons de renouvellement (hachés SHA-256), rotation à chaque usage.
model RefreshToken {
  id          String    @id @default(cuid())
  adminUserId String    @map("admin_user_id")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([adminUserId])
  @@map("refresh_token")
}

/// Hors TRD : demandes de devis ou de rappel (RF-18), avec consentement explicite.
/// L'adresse IP n'est jamais stockée en clair (HMAC-SHA256).
model Lead {
  id           String      @id @default(uuid()) @db.Uuid
  simulationId String?     @map("simulation_id") @db.Uuid
  simulation   Simulation? @relation(fields: [simulationId], references: [id])
  name         String
  phone        String
  email        String?
  city         String?
  message      String?
  consentAt    DateTime    @map("consent_at")
  ipHash       String?     @map("ip_hash")
  createdAt    DateTime    @default(now()) @map("created_at")

  @@map("lead")
}
