# Copier en apps/api/.env (dev) ; en production, variables Vercel / intégration Neon.
NODE_ENV=development
PORT=3000

# PostgreSQL : connexion poolée pour l'application, directe pour les migrations Prisma.
DATABASE_URL=postgresql://simulateur:simulateur@localhost:5432/simulateur_dev
DATABASE_URL_UNPOOLED=postgresql://simulateur:simulateur@localhost:5432/simulateur_dev
# Base des tests e2e (réinitialisée à chaque exécution).
DATABASE_URL_TEST=postgresql://simulateur:simulateur@localhost:5432/simulateur_test

# Auth : secret HS256 du jeton d'accès (≥ 32 caractères).
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
# Cookie de renouvellement en Secure (true en production HTTPS).
COOKIE_SECURE=false
# Origines CORS autorisées, séparées par des virgules (vide = aucune origine croisée).
CORS_ORIGINS=http://localhost:4200

# Hachage des adresses IP (formulaire de devis) : HMAC-SHA256 avec ce secret.
IP_HASH_SECRET=change-me-ip-hash-secret

# Médias : "local" (dev/tests) ou "vercel-blob" (production).
STORAGE_DRIVER=local
LOCAL_MEDIA_DIR=tmp/media
PUBLIC_MEDIA_BASE_URL=http://localhost:3000/media
# Requis si STORAGE_DRIVER=vercel-blob.
BLOB_READ_WRITE_TOKEN=

# Compte ADMIN initial créé par le seed (ignoré s'il existe déjà).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-2026!
